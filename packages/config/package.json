{
  "name": "@moniq/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "typebox": "^1.3.12"
  },
  "devDependencies": {
    "@moniq/eslint-config": "workspace:*",
    "@moniq/typescript-config": "workspace:*",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.10"
  }
}
